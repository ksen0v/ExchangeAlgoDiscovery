# Coin monitored after the first start (later the last chosen coin is remembered)
DEFAULT_COIN=BTC

# Telegram alerts: create a bot with @BotFather, send it any message,
# then take chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Host port for docker-compose
PORT=8000
LOG_LEVEL=INFO

# Protect a server reachable from the internet: open http://host:8000/?token=... once
AUTH_TOKEN=
# Delete alerts older than N days (0 = keep forever)
ALERTS_KEEP_DAYS=30
# Time zone for Telegram messages, e.g. Europe/Moscow (empty = server time)
TIMEZONE=
# 1 = simulated exchanges (try the UI without network access)
DEMO=0

# М6 (займы для шортов): ключ Binance ТОЛЬКО НА ЧТЕНИЕ - без торговли и вывода, с белым списком IP.
# Ключ с правом торговли или вывода программа откажется использовать.
# В десктоп-версии этот файл кладётся в папку данных: %APPDATA%\ManipulationRadar\.env
BINANCE_API_KEY=
BINANCE_API_SECRET=
