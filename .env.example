# Coin monitored after the first start (later the last chosen coin is remembered)
DEFAULT_COIN=BTC

# Telegram alerts: create a bot with @BotFather, send it any message,
# then take chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Host port for docker-compose
PORT=8000
LOG_LEVEL=INFO
